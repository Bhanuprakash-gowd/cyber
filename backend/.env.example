# CyberSentry AI Backend Environment Variables
PORT=5000
FLASK_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Machine Learning Model
MODEL_PATH=./model/phishing_model.joblib
MODEL_VERSION=1.2.0

# LLM Provider Configuration (Optional - falls back to internal security expert engine if empty)
LLM_PROVIDER=openai
LLM_API_KEY=your_optional_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# External RSS/Atom Feeds for Threat Intelligence
RSS_FEEDS=https://www.cisa.gov/cybersecurity-advisories/all.xml,https://feeds.feedburner.com/TheHackersNews,https://www.bleepingcomputer.com/feed/

# Admin Moderation Master Token
ADMIN_SECRET_KEY=cybersentry-admin-secret-dev-2026
